# Allowlist: only what the Dockerfile copies. Keeps secrets (.env.local) and local
# data (forecast/) out of the build context.
*

!python/pyproject.toml
!python/uv.lock
!python/README.md
!python/config/
!python/upslope/

!webapp/

# re-exclude inside the allowed directories
**/__pycache__
**/.DS_Store
webapp/node_modules
webapp/dist
webapp/*.local
