# Copy to .env.local (gitignored) and fill in. `just` loads .env.local for every recipe.

# python: S3/Tigris storage used by `upslope export-web` and `upslope serve`
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_ENDPOINT_URL_IAM=
AWS_REGION=
# BUCKET_NAME=upslope-storage

# python: bearer token for the admin API (/admin) and the annotation page; unset disables them.
# Production sets it with `fly secrets set ADMIN_TOKEN=...`; the local stack defaults to upslope-local-admin.
ADMIN_TOKEN=

# webapp: public Mapbox token for /map (optional; /map warns without it)
VITE_MAPBOX_TOKEN=
# VITE_FORECAST_BASE_URL=https://forecast-api.example  # defaults to /api/forecast
